menu "Tivoo Wi-Fi"

config TIVOO_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        Local 2.4 GHz Wi-Fi network name. Stored in the local sdkconfig.

config TIVOO_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        Local Wi-Fi password. Stored in the local sdkconfig and never logged.

endmenu

menu "Tivoo I2S audio"

config TIVOO_I2S_BCLK_GPIO
    int "Shared BCLK GPIO"
    range 0 33
    default 4

config TIVOO_I2S_WS_GPIO
    int "Shared WS GPIO"
    range 0 33
    default 5

config TIVOO_I2S_DIN_GPIO
    int "INMP441 SD GPIO"
    range 0 39
    default 6

config TIVOO_I2S_DOUT_GPIO
    int "PCM5102 DIN GPIO"
    range -1 33
    default 7
    help
        -1 leaves DAC data disconnected and playback unavailable.

config TIVOO_AEC_REFERENCE_DELAY_SAMPLES
    int "Fixed TX to microphone reference delay in 16 kHz samples"
    range 0 800
    default 0
    help
        Uncalibrated S3 initial value only; measure the physical TX/RX
        alignment and acoustic path before enabling AFE.

config TIVOO_AUDIO_PROBE
    bool "Log one-second audio measurements to UART"
    default n
    help
        Report raw left/right slot, filtered microphone, and AFE output
        levels without requiring a network connection or speech detection.

endmenu
