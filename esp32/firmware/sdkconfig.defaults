# Waveshare ESP32-S3-DEV-KIT-N16R8-M; P6.8 b1 smoke model only.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Locked ESP-SR recommends 64-byte data-cache lines for PSRAM throughput.
# Retain 32KB capacity: a 64KB cache would consume another 32KB internal heap.
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Keep ordinary audio/network buffers out of scarce internal task/DMA memory.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
# Low-memory receive window; retain the value exercised on the assembled S3.
CONFIG_ESP_WIFI_RX_BA_WIN=2
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_BT_ENABLED is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# PCM streaming must tolerate application scheduling jitter without closing
# the TCP receive window after only ~90 ms of 32 kHz mono PCM.
CONFIG_LWIP_TCP_WND_DEFAULT=14360
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
# B8.7 measured CPU0 real-time AFE / TX activity can starve IDLE0 and make
# the default idle-task watchdog stall DMA. Monitor IDLE1; keep the task
# watchdog and CPU1 interrupt watchdog enabled, without relaxing send timers.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0 is not set
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_WN_WN9_HIWALLE_TTS2=y
CONFIG_TIVOO_AEC_REFERENCE_DELAY_SAMPLES=0

# Sustained dual-mic AFE and PCM ingress exceed the default -Og CPU budget.
# Keep assertions/debug symbols, but compile the normal firmware for speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
