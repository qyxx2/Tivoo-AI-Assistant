# Copy to .env and replace placeholders before deployment.
# From deploy/nas/compose:
# docker compose --env-file ../config/sherpa-wyoming/.env -f sherpa-wyoming.yml config
#
# Use only a SHA tag published by a successful GitHub Actions feature-branch run.
# GHCR is private by default; authenticate on the NAS separately with read:packages only.
# Store that credential in DSM/Docker credential storage, never in this file.
IMAGE_TAG=sha-replace-with-published-commit-sha

# Dedicated Docker internal-only, non-attachable bridge for Sherpa.
# HA runs in host mode and reaches the container IP through the NAS host namespace.
# Do not attach other containers and do not publish TCP 10400 to the NAS host/LAN.
HA_DOCKER_NETWORK=replace-with-dedicated-internal-network

# Persistent NAS path; the preparation script creates kws/, stt/ and tts/ below it.
# Prepare from the repo root with: NAS_MODELS_DIR=<this path> bash deploy/nas/scripts/prepare-sherpa-wyoming-models.sh
NAS_MODELS_DIR=/replace/with/persistent/nas/model-directory

# Set the intended wake phrase. English tokens must exist in the pinned KWS en.phone lexicon.
WAKE_WORD_PHRASE=replace-with-your-wake-phrase

KWS_NUM_THREADS=1
KWS_SCORE=1.0
KWS_THRESHOLD=0.25
STT_NUM_THREADS=2
TTS_NUM_THREADS=1
LOG_LEVEL=INFO
